{
    "name": "test-web-use-ai",
    "type": "module",
    "private": true,
    "workspaces": [
        "packages/*",
        "app/*"
    ],
    "devDependencies": {
        "@babel/parser": "7",
        "@babel/types": "7",
        "@stryker-mutator/core": "^10.0.0",
        "@types/bun": "^1.3.14",
        "@types/istanbul-lib-coverage": "^2.0.6",
        "@types/istanbul-lib-instrument": "^1.7.8",
        "@types/istanbul-lib-report": "^3.0.3",
        "@types/istanbul-reports": "^3.0.4",
        "happy-dom": "^20.14.5",
        "istanbul-lib-coverage": "3",
        "istanbul-lib-instrument": "6",
        "istanbul-lib-report": "3",
        "istanbul-reports": "3",
        "mprocs": "^0.9.6",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "dev": "mprocs \"bun run --hot app/server/src/index.ts\" \"bun run --cwd app/web dev\"",
        "dev:server": "bun run --hot app/server/src/index.ts",
        "dev:web": "bun run --cwd app/web dev",
        "build:web": "bun run --cwd app/web build",
        "build:assets": "bun scripts/gen-assets.ts",
        "build:exe": "bun run build:web && bun run build:assets && bun scripts/build-exe.ts",
        "build:exe:win": "bun run build:web && bun run build:assets && bun scripts/build-exe.ts --target=bun-windows-x64",
        "build:exe:mac": "bun run build:web && bun run build:assets && bun scripts/build-exe.ts --target=bun-darwin-arm64",
        "build:exe:all": "bun run build:web && bun run build:assets && bun scripts/build-exe.ts --target=bun-windows-x64 && bun scripts/build-exe.ts --target=bun-darwin-arm64",
        "start": "bun app/server/src/index.ts",
        "test": "bun test ./tests ./app/server/tests ./packages/shared/tests && bun test --preload ./app/web/tests/helpers/dom.ts ./app/web/tests",
        "lint": "oxlint --deny-warnings .",
        "lint:fix": "oxlint --fix --deny-warnings .",
        "format": "oxfmt app packages scripts tests",
        "format:check": "oxfmt --check app packages scripts tests",
        "crap": "bun scripts/crap-check.ts",
        "mutate": "stryker run",
        "typecheck": "tsc --noEmit && bun --filter '@lookrun/*' typecheck",
        "test:quality": "bun scripts/test-quality.ts",
        "check": "bun run format:check && bun run lint && bun run typecheck"
    },
    "version": "0.1.0",
    "patchedDependencies": {
        "sharp@0.34.5": "patches/sharp@0.34.5.patch",
        "source-map-support@0.5.21": "patches/source-map-support@0.5.21.patch",
        "@midscene/android@1.10.6": "patches/@midscene%2Fandroid@1.10.6.patch"
    },
    "packageManager": "bun@1.3.14"
}
