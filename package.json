{
  "name": "test-web-use-ai",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@midscene/android": "1.10.6",
    "@midscene/web": "^1.10.6",
    "@uiw/react-codemirror": "^4.25.11",
    "antd": "^6.5.1",
    "hono": "^4.12.31",
    "puppeteer-core": "^25.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "sharp": "^0.34.5",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"bun run --hot src/server/index.ts\" \"vite\"",
    "dev:server": "bun run --hot src/server/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:assets": "bun scripts/gen-assets.ts",
    "build:exe": "bun run build:web && bun run build:assets && bun scripts/build-exe.ts",
    "build:exe:win": "bun run build:web && bun run build:assets && bun scripts/build-exe.ts --target=bun-windows-x64",
    "build:exe:mac": "bun run build:web && bun run build:assets && bun scripts/build-exe.ts --target=bun-darwin-arm64",
    "build:exe:all": "bun run build:web && bun run build:assets && bun scripts/build-exe.ts --target=bun-windows-x64 && bun scripts/build-exe.ts --target=bun-darwin-arm64",
    "start": "bun src/server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json"
  },
  "version": "0.1.0",
  "patchedDependencies": {
    "sharp@0.34.5": "patches/sharp@0.34.5.patch",
    "source-map-support@0.5.21": "patches/source-map-support@0.5.21.patch",
    "@midscene/android@1.10.6": "patches/@midscene%2Fandroid@1.10.6.patch"
  }
}
