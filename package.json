{
  "name": "test-web-use-ai",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@midscene/web": "^1.10.6",
    "@uiw/react-codemirror": "^4.25.11",
    "antd": "^6.5.1",
    "hono": "^4.12.31",
    "puppeteer-core": "^25.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"bun run --hot src/server/index.ts\" \"vite\"",
    "dev:server": "bun run --hot src/server/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:assets": "bun scripts/gen-assets.ts",
    "build:exe": "bun run build:web && bun run build:assets && bun scripts/build-exe.ts",
    "start": "bun src/server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json"
  },
  "version": "0.1.0"
}
